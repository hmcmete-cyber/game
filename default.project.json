{
  "name": "game",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 256,
        "StreamingTargetRadius": 900,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "StreamOutBehavior": "Opportunistic"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
